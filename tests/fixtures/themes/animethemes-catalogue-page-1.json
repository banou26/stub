{"data":{"animePagination":{"paginatorInfo":{"hasMorePages":true},"data":[{"id":1,"slug":"hackliminality","title":{"romaji":".hack\/\/Liminality","english":null,"native":null},"format":"OVA","season":"SPRING","year":2002,"synopsis":"While playing the newly released MMORPG &lsquo;The World&rsquo;, Minase Mai and Tomonari Kasumi collapsed in the real world and were sent to the hospital after hearing a mysterious sound. Only Mai had recovered while her friend Kasumi had slipped into a mysterious coma. Mai is later approached by the creator of &lsquo;The World&rsquo;, Tokuoka Junichiro, who unveils to her that, just like her friend, six other players across the country had also collapsed while playing &lsquo;The World&rsquo; and are now in mysterious comas. What exactly is &lsquo;The World&rsquo;, what is this mysterious sound Mai keeps on hearing, and why are people slipping into comas from this game? Minase, Junichiro and their acquaintances set off to get to the bottom of this problem before any further harm happens.\n\n[Written by MAL Rewrite]","updatedAt":"2021-03-27 23:40:39","resources":{"nodes":[{"site":"MAL","externalId":299,"link":"https:\/\/myanimelist.net\/anime\/299"},{"site":"ANILIST","externalId":299,"link":"https:\/\/anilist.co\/anime\/299"},{"site":"KITSU","externalId":274,"link":"https:\/\/kitsu.app\/anime\/274"},{"site":"ANIDB","externalId":222,"link":"https:\/\/anidb.net\/anime\/222"},{"site":"ANN","externalId":709,"link":"https:\/\/www.animenewsnetwork.com\/encyclopedia\/anime.php?id=709"},{"site":"ANIME_PLANET","externalId":283,"link":"https:\/\/www.anime-planet.com\/anime\/hack-liminality"}]},"animethemes":[{"id":1549,"type":"OP","sequence":1,"slug":"OP1","song":{"title":{"romaji":"Edge","native":null},"performances":[{"as":null,"alias":null,"artist":{"name":{"main":"See-Saw"}}}]},"animethemeentries":[{"version":1,"episodes":"1","nsfw":false,"spoiler":false,"videos":{"nodes":[{"link":"https:\/\/v.animethemes.moe\/DotHackLiminality-OP1.webm","resol