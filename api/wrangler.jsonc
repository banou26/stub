{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stub-api",
  // what vite.api.config.ts builds (npm run build:api)
  "main": "build/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.stub.banou.dev", "custom_domain": true }],
  // a placeholder until the namespace exists: `wrangler kv namespace create stub-api-store`, then its id here
  "kv_namespaces": [{ "binding": "STORE", "id": "00000000000000000000000000000000" }],
  // namespace_id is any integer no other rate limit binding of the account uses
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "921", "simple": { "limit": 1000, "period": 60 } }],
  // off: a Workers log keeps each request's method and URL for days
  "observability": { "enabled": false },
}
