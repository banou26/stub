{
  "name": "@banou/stub",
  "version": "0.0.62",
  "description": "Anime, shows and movies in one place: every source merged into one page per title, played and tracked on your own accounts.",
  "keywords": [
    "fkn",
    "fkn-type:app"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/stub.git"
  },
  "fkn": {
    "app": "fkn:app:173elff365hgaijng4mufbd4zo6lypfskb3zdd5jkpgd4hj4ovjjq",
    "signed": true,
    "url": "https://stub.fkn.app/",
    "background": "store/background.webp",
    "cover": "store/cover.webp",
    "screenshots": [
      "store/home.webp",
      "store/title.webp",
      "store/movie.webp",
      "store/series.webp",
      "store/search.webp",
      "store/phone.webp"
    ]
  },
  "files": [
    "build",
    "!build/assets/*history-shards-*.js",
    "!build/assets/*-[0-9][0-9][0-9]-*.js",
    "fkn.json",
    "store"
  ],
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vp dev --port 4560",
    "test-server": "vp dev --port 7357 --config vite.test.config.ts",
    "build": "npm run data:build && vp build && vp build --config vite.lib.config.ts && vp build --config vite.preview.config.ts && node scripts/check-npm-entry.mjs",
    "data:build": "npm run gql-generate && node scripts/build-anime-data.mjs",
    "data:build-offline": "npm run gql-generate && node scripts/build-anime-data.mjs --offline",
    "icons:render": "sh scripts/render-icons.sh",
    "corpus:walk": "node scripts/walk-season-answers.mjs",
    "corpus:label": "node scripts/label-corpus.mjs",
    "corpus:replay": "node scripts/replay-answers.mjs",
    "build-test": "npm run data:build && vp build --config vite.test.config.ts",
    "build-test-watch": "vp build --config vite.test.config.ts --watch",
    "test": "npm run test:unit && npm run build-test && playwright test",
    "test-watch": "set PWTEST_WATCH=1 & playwright test",
    "test-watch-headful": "playwright test --ui",
    "gql-generate": "graphql-codegen --config codegen.ts",
    "gql-generate-watch": "graphql-codegen --config codegen.ts --watch",
    "type-check": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test:unit": "vitest run",
    "calibrate": "node scripts/fetch-title-corpus.mjs && vitest run --config vitest.calibration.config.ts --disableConsoleIntercept --reporter=verbose"
  },
  "dependencies": {
    "@banou/media-player": "^0.10.31",
    "@banou/ponyfill": "^0.0.13",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@envelop/on-resolve": "^6.0.0",
    "@fkn/lib": "^0.9.66",
    "@floating-ui/react": "^0.27.16",
    "@graphql-yoga/plugin-defer-stream": "^3.15.1",
    "@graphql-yoga/plugin-response-cache": "^3.17.2",
    "@urql/devtools": "^2.0.3",
    "@urql/exchange-graphcache": "^8.1.0",
    "@videojs/core": "10.0.0-beta.26",
    "@videojs/media": "10.0.0-beta.26",
    "@videojs/react": "10.0.0-beta.26",
    "@xyflow/react": "^12.11.6",
    "dataloader": "^2.2.3",
    "frizbee": "^0.13.0",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.15.1",
    "kleur": "^4.1.5",
    "lru-cache": "^11.2.1",
    "lucide-react": "^0.536.0",
    "marked": "^17.0.5",
    "osra": "^0.6.4",
    "preact": "^11.0.0-beta.0",
    "react-hook-form": "^7.62.0",
    "react-intl": "^12.1.5",
    "react-window": "^2.0.1",
    "sacha": "^0.2.4",
    "sanitize-html": "^2.18.1",
    "trace.moe-id": "^2.0.0",
    "urql": "^4.2.2",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@eddeee888/gcg-typescript-resolver-files": "^0.12.1",
    "@formatjs/cli": "^6.16.35",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-document-nodes": "^4.0.16",
    "@graphql-codegen/typescript-resolvers": "^4.5.1",
    "@graphql-codegen/urql-introspection": "^3.0.1",
    "@kawaiioverflow/arm": "^0.239.0",
    "@parcel/watcher": "^2.5.1",
    "@playwright/test": "^1.54.2",
    "@preact/preset-vite": "^2.10.2",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/react-dom": "^19.1.7",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.0.1",
    "aws4fetch": "^1.0.20",
    "chai": "^5.2.1",
    "chai-as-promised": "^8.0.1",
    "chai-shallow-deep-equal": "^1.4.6",
    "eslint-plugin-formatjs": "^8.1.2",
    "linkedom": "^0.18.12",
    "patch-package": "^8.0.1",
    "playwright": "^1.54.2",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "@graphql-tools/utils": "^12.0.3",
    "lodash": "^4.18.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
